<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="20" alignment="TOP_CENTER"
      fx:controller="com.smartdesk.controllers.EmployeeProfileController"
      styleClass="profile-container">

    <!-- Padding via Insets to fix previous error -->
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Title -->
    <Label text="My Profile" styleClass="profile-title"/>

    <!-- Profile Photo Section -->
    <VBox alignment="CENTER" spacing="10">
   <ImageView fx:id="profileImage" fitWidth="100" fitHeight="100"
           pickOnBounds="true" preserveRatio="true"
           styleClass="profile-image" />
<Button text="Change Photo" fx:id="changePhotoBtn" styleClass="update-btn"
        onAction="#handleChangePhoto"/>

</VBox>


    <!-- Profile Form Card -->
    <VBox spacing="15" styleClass="profile-card" alignment="CENTER_LEFT" maxWidth="400">

        <GridPane hgap="10" vgap="10">
            <Label text="Name:"/>
            <TextField fx:id="nameField" promptText="Enter your name"/>

            <Label text="Email:" GridPane.rowIndex="1"/>
            <TextField fx:id="emailField" GridPane.rowIndex="1" promptText="Enter your email"/>

            <Label text="Department:" GridPane.rowIndex="2"/>
            <TextField fx:id="deptField" GridPane.rowIndex="2" promptText="Enter department"/>

            <Label text="Role:" GridPane.rowIndex="3"/>
            <TextField fx:id="roleField" GridPane.rowIndex="3" promptText="Enter role"/>
        </GridPane>

        <Button text="Update Profile" fx:id="updateBtn" styleClass="update-btn"/>

    </VBox>

</VBox>