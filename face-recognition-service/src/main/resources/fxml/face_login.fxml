<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartdesk.facerecognition.FaceLoginController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <TextField fx:id="usernameField" promptText="Enter username" maxWidth="200"/>
    <Button fx:id="registerButton" text="Register Face" maxWidth="200"/>
    <Button fx:id="loginButton" text="Login with Face" maxWidth="200"/>
</VBox>
